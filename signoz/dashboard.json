{
  "title": "DevGuard AI — Observability & Resilience",
  "name": "devguard-observability",
  "description": "SRE dashboard for the DevGuard AI 3-agent pipeline. Panels: request latency (p50/p95/p99 + 3s SLO marker), cost per request, token usage over time, LLM error rate, circuit breaker state changes, and cache hit ratio. Import via Dashboards -> Import JSON. All panels are driven by OTel metrics emitted from backend/core/telemetry.py.",
  "tags": ["devguard", "llm", "sre", "resilience", "hackathon"],
  "version": "v4",
  "uploadedGrafana": false,
  "collapsableRowsMigrated": true,
  "variables": {
    "env-var": {
      "id": "env-var",
      "name": "deployment_environment",
      "description": "Filter by deployment environment (production/staging).",
      "type": "QUERY",
      "queryValue": "SELECT DISTINCT JSONExtractString(labels, 'deployment_environment') AS env FROM signoz_metrics.distributed_time_series_v4_1day WHERE metric_name = 'devguard_scan_latency'",
      "customValue": "",
      "textboxValue": "",
      "multiSelect": false,
      "showALLOption": true,
      "sort": "ASC",
      "order": 0,
      "selectedValue": "production",
      "allSelected": false,
      "modificationUUID": "b2d1f0a0-0001-4a10-9c01-devguardenv01"
    }
  },
  "panelMap": {},
  "layout": [
    { "i": "panel-latency",       "x": 0, "y": 0,  "w": 6, "h": 8, "moved": false, "static": false },
    { "i": "panel-cost",          "x": 6, "y": 0,  "w": 6, "h": 8, "moved": false, "static": false },
    { "i": "panel-tokens",        "x": 0, "y": 8,  "w": 6, "h": 8, "moved": false, "static": false },
    { "i": "panel-error-rate",    "x": 6, "y": 8,  "w": 6, "h": 8, "moved": false, "static": false },
    { "i": "panel-breaker",       "x": 0, "y": 16, "w": 6, "h": 8, "moved": false, "static": false },
    { "i": "panel-cache-ratio",   "x": 6, "y": 16, "w": 6, "h": 8, "moved": false, "static": false }
  ],
  "widgets": [
    {
      "id": "panel-latency",
      "title": "Request Latency (p50 / p95 / p99)",
      "description": "End-to-end /scan latency percentiles from the devguard_scan_latency histogram. SLO objective line at 3000ms; sustained p99 above it burns the error budget (see /slo-status).",
      "panelTypes": "graph",
      "yAxisUnit": "ms",
      "thresholds": [
        {
          "index": "slo-3s",
          "keyIndex": 0,
          "thresholdValue": 3000,
          "thresholdUnit": "ms",
          "thresholdColor": "#F5222D",
          "thresholdLabel": "SLO: 3s objective",
          "thresholdOperator": ">",
          "thresholdFormat": "Text"
        }
      ],
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "legend": "p50",
              "dataSource": "metrics",
              "aggregateOperator": "p50",
              "timeAggregation": "p50",
              "spaceAggregation": "p50",
              "aggregateAttribute": { "key": "devguard_scan_latency", "type": "Histogram", "dataType": "float64", "isColumn": true },
              "filters": { "op": "AND", "items": [] },
              "groupBy": [],
              "reduceTo": "avg",
              "disabled": false,
              "stepInterval": 60
            },
            {
              "queryName": "B",
              "expression": "B",
              "legend": "p95",
              "dataSource": "metrics",
              "aggregateOperator": "p95",
              "timeAggregation": "p95",
              "spaceAggregation": "p95",
              "aggregateAttribute": { "key": "devguard_scan_latency", "type": "Histogram", "dataType": "float64", "isColumn": true },
              "filters": { "op": "AND", "items": [] },
              "groupBy": [],
              "reduceTo": "avg",
              "disabled": false,
              "stepInterval": 60
            },
            {
              "queryName": "C",
              "expression": "C",
              "legend": "p99",
              "dataSource": "metrics",
              "aggregateOperator": "p99",
              "timeAggregation": "p99",
              "spaceAggregation": "p99",
              "aggregateAttribute": { "key": "devguard_scan_latency", "type": "Histogram", "dataType": "float64", "isColumn": true },
              "filters": { "op": "AND", "items": [] },
              "groupBy": [],
              "reduceTo": "avg",
              "disabled": false,
              "stepInterval": 60
            }
          ],
          "queryFormulas": []
        },
        "clickhouse_sql": [{ "name": "A", "query": "", "legend": "", "disabled": false }],
        "promql": [{ "name": "A", "query": "", "legend": "", "disabled": false }]
      }
    },
    {
      "id": "panel-cost",
      "title": "Cost per Request (USD)",
      "description": "p95 of devguard_llm_cost_per_request, split by model. When the circuit breaker degrades to the fallback model this line should DROP (fallback is cheaper) — a fast visual confirmation of graceful degradation.",
      "panelTypes": "graph",
      "yAxisUnit": "none",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "legend": "{{model}} cost p95",
              "dataSource": "metrics",
              "aggregateOperator": "p95",
              "timeAggregation": "p95",
              "spaceAggregation": "p95",
              "aggregateAttribute": { "key": "devguard_llm_cost_per_request", "type": "Histogram", "dataType": "float64", "isColumn": true },
              "filters": { "op": "AND", "items": [] },
              "groupBy": [{ "key": "model", "type": "tag", "dataType": "string", "isColumn": false }],
              "reduceTo": "avg",
              "disabled": false,
              "stepInterval": 60
            }
          ],
          "queryFormulas": []
        },
        "clickhouse_sql": [{ "name": "A", "query": "", "legend": "", "disabled": false }],
        "promql": [{ "name": "A", "query": "", "legend": "", "disabled": false }]
      }
    },
    {
      "id": "panel-tokens",
      "title": "Token Usage Over Time",
      "description": "Rate of devguard_llm_tokens_total, grouped by model. Correlate token spikes with latency/cost spikes to identify runaway reflection loops.",
      "panelTypes": "graph",
      "yAxisUnit": "short",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "legend": "{{model}} tokens/s",
              "dataSource": "metrics",
              "aggregateOperator": "rate",
              "timeAggregation": "rate",
              "spaceAggregation": "sum",
              "aggregateAttribute": { "key": "devguard_llm_tokens_total", "type": "Sum", "dataType": "float64", "isColumn": true },
              "filters": { "op": "AND", "items": [] },
              "groupBy": [{ "key": "model", "type": "tag", "dataType": "string", "isColumn": false }],
              "reduceTo": "sum",
              "disabled": false,
              "stepInterval": 60
            }
          ],
          "queryFormulas": []
        },
        "clickhouse_sql": [{ "name": "A", "query": "", "legend": "", "disabled": false }],
        "promql": [{ "name": "A", "query": "", "legend": "", "disabled": false }]
      }
    },
    {
      "id": "panel-error-rate",
      "title": "LLM Error Rate",
      "description": "Rate of devguard_llm_exceptions_total, grouped by error.type (AgentExecutionError, TimeoutError, etc.). This is the leading indicator that trips the circuit breaker — watch it rise just before a breaker OPEN event on the panel to the left-below.",
      "panelTypes": "graph",
      "yAxisUnit": "short",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "legend": "{{error_type}}",
              "dataSource": "metrics",
              "aggregateOperator": "rate",
              "timeAggregation": "rate",
              "spaceAggregation": "sum",
              "aggregateAttribute": { "key": "devguard_llm_exceptions_total", "type": "Sum", "dataType": "float64", "isColumn": true },
              "filters": { "op": "AND", "items": [] },
              "groupBy": [{ "key": "error_type", "type": "tag", "dataType": "string", "isColumn": false }],
              "reduceTo": "sum",
              "disabled": false,
              "stepInterval": 60
            }
          ],
          "queryFormulas": []
        },
        "clickhouse_sql": [{ "name": "A", "query": "", "legend": "", "disabled": false }],
        "promql": [{ "name": "A", "query": "", "legend": "", "disabled": false }]
      }
    },
    {
      "id": "panel-breaker",
      "title": "Circuit Breaker State Changes",
      "description": "Count of devguard_circuit_breaker_state_changes_total, grouped by the target state (open/half_open/closed). Each bar is a real state transition; an OPEN spike here that lines up with an error-rate spike is your blast-radius-containment working as designed.",
      "panelTypes": "graph",
      "yAxisUnit": "short",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "legend": "-> {{to}}",
              "dataSource": "metrics",
              "aggregateOperator": "increase",
              "timeAggregation": "increase",
              "spaceAggregation": "sum",
              "aggregateAttribute": { "key": "devguard_circuit_breaker_state_changes_total", "type": "Sum", "dataType": "float64", "isColumn": true },
              "filters": { "op": "AND", "items": [] },
              "groupBy": [{ "key": "to", "type": "tag", "dataType": "string", "isColumn": false }],
              "reduceTo": "sum",
              "disabled": false,
              "stepInterval": 60
            }
          ],
          "queryFormulas": []
        },
        "clickhouse_sql": [{ "name": "A", "query": "", "legend": "", "disabled": false }],
        "promql": [{ "name": "A", "query": "", "legend": "", "disabled": false }]
      }
    },
    {
      "id": "panel-cache-ratio",
      "title": "Cache Hit Ratio",
      "description": "Formula F1 = hits / (hits + misses) from devguard_cache_hit_total and devguard_cache_miss_total. A healthy repeat-scan workload (e.g. CI re-scanning the same PR) should trend toward a high ratio; a sudden drop to ~0 usually means Redis is down and we've correctly failed OPEN to cache-less operation.",
      "panelTypes": "value",
      "yAxisUnit": "percentunit",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "expression": "A",
              "legend": "hits",
              "dataSource": "metrics",
              "aggregateOperator": "increase",
              "timeAggregation": "increase",
              "spaceAggregation": "sum",
              "aggregateAttribute": { "key": "devguard_cache_hit_total", "type": "Sum", "dataType": "float64", "isColumn": true },
              "filters": { "op": "AND", "items": [] },
              "groupBy": [],
              "reduceTo": "sum",
              "disabled": true,
              "stepInterval": 60
            },
            {
              "queryName": "B",
              "expression": "B",
              "legend": "misses",
              "dataSource": "metrics",
              "aggregateOperator": "increase",
              "timeAggregation": "increase",
              "spaceAggregation": "sum",
              "aggregateAttribute": { "key": "devguard_cache_miss_total", "type": "Sum", "dataType": "float64", "isColumn": true },
              "filters": { "op": "AND", "items": [] },
              "groupBy": [],
              "reduceTo": "sum",
              "disabled": true,
              "stepInterval": 60
            }
          ],
          "queryFormulas": [
            { "queryName": "F1", "expression": "A / (A + B)", "legend": "cache hit ratio", "disabled": false }
          ]
        },
        "clickhouse_sql": [{ "name": "A", "query": "", "legend": "", "disabled": false }],
        "promql": [{ "name": "A", "query": "", "legend": "", "disabled": false }]
      }
    }
  ]
}
