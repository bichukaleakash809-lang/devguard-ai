# DevGuard AI — backend environment.
# Copy to .env and fill in. Never commit .env itself.
#
#   cp .env.example .env

# ---- Required for live scans -------------------------------------------------
# Groq API key. Get one at https://console.groq.com/keys
# The backend now imports and boots WITHOUT this set — every endpoint that does
# not call an LLM works fine. It is required only when you run an actual scan.
GROQ_API_KEY=

# ---- Server ------------------------------------------------------------------
# Port the backend listens on. Must match NEXT_PUBLIC_API_BASE in the frontend
# and the published port in docker-compose.yml.
PORT=8000

# ---- Cache (optional) --------------------------------------------------------
# Redis is optional; the backend degrades to an in-process cache when it is
# unreachable. Under docker compose this is redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# ---- OpenTelemetry / SigNoz (optional) ---------------------------------------
# Where to export traces, metrics and logs. Leave unset to run without a
# collector — telemetry is fail-safe and a scan never depends on it.
#   local collector (docker compose --profile obs):  http://localhost:4317
#   SigNoz Cloud:                                    https://ingest.<region>.signoz.cloud:443
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=devguard-backend

# For SigNoz Cloud only — the ingestion key header.
# OTEL_EXPORTER_OTLP_HEADERS=signoz-access-token=<your-ingestion-key>

# Set to true to disable telemetry export entirely (useful for tests/CI).
# OTEL_SDK_DISABLED=true

# ---- SigNoz MCP (optional) ---------------------------------------------------
# Base URL of the SigNoz MCP server used by the self-observation layer.
#
# NOTE: this integration is NOT yet verified against a real SigNoz MCP server —
# see backend/core/mcp_client.py and docs/AUDIT.md §3.B. When it is unreachable
# the cost path falls back to an in-process estimate, which is reported with
# data_source "local_shadow" rather than "live".
SIGNOZ_MCP_URL=http://localhost:8080
